{
  "name": "cloud-webapp-module03",
  "private": true,
  "version": "1.0.0",
  "description": "TaskFlow demo using Cloudflare Workers and D1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "db:migrate:local": "wrangler d1 migrations apply taskflow-module03 --local",
    "db:migrate:remote": "wrangler d1 migrations apply taskflow-module03 --remote",
    "deploy": "wrangler deploy",
    "test:smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": { "wrangler": "4.159.0" }
}

